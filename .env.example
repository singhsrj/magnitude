# Copy to .env.local (git-ignored). With these two set the app plays locally and syncs to the backend in the
# background. Leave them out and the app behaves exactly as before Phase 4: everything stays in this browser.
#
# Start the backend first:  cd backend && docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SYNC=on

# ---- Clerk (sign-in). Keys come from the Clerk dashboard > API keys; `npx clerk@latest env pull` writes them to .env.local.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
