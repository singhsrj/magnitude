# Copy to backend/.env and fill in. Never commit the real file.

# ---- Neon (Postgres) ------------------------------------------------------
# Neon dashboard > Connect. You need BOTH connection strings.
# Pooled: the host contains "-pooler". Used by the running rating service.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct: same string without "-pooler". Used only by `alembic upgrade head`.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Upstash (Redis) ------------------------------------------------------
# Upstash console > your database > the TCP / redis-cli connection string, in rediss:// form
# (two s's = TLS). Not the REST URL.
REDIS_URL=rediss://default:PASSWORD@xxxxxxxx.upstash.io:6379

# ---- Services -------------------------------------------------------------
# Shared secret between the rating and problem services.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Optional tuning (defaults shown)
# RATE_LIMIT_PER_MINUTE=120
# SIGNUP_LIMIT_PER_HOUR=10
# PROBLEM_TTL_SECONDS=30
# PROFILE_CACHE_SECONDS=30
