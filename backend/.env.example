# Copy to backend/.env and fill in. Never commit the real file.

# ---- Neon (Postgres) ------------------------------------------------------
# Neon dashboard > Connect. You need BOTH connection strings.
# Pooled: the host contains "-pooler". Used by the running rating service.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct: same string without "-pooler". Used only by `alembic upgrade head`.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Upstash (Redis) ------------------------------------------------------
# Upstash console > your database > the TCP / redis-cli connection string, in rediss:// form
# (two s's = TLS). Not the REST URL.
REDIS_URL=rediss://default:PASSWORD@xxxxxxxx.upstash.io:6379

# ---- Service ---------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Optional tuning (defaults shown)
# RATE_LIMIT_PER_MINUTE=120
# SIGNUP_LIMIT_PER_HOUR=10
# SESSION_LIMIT_PER_MINUTE=30
# PROFILE_CACHE_SECONDS=30

# ---- Clerk (sign-in) --------------------------------------------------------
# The publishable key from the Clerk dashboard > API keys (the same public value the frontend uses). The backend
# derives Clerk's signing-key address from it and verifies session tokens; no secret key is needed here.
# Leave unset to accept only anonymous device tokens.
# CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- Deploy (Render) ---------------------------------------------------------
# Optional regex for origins that change per deploy (Vercel/Netlify previews), e.g.
# CORS_ORIGIN_REGEX=^https://magnitude(-[a-z0-9-]+)?\.vercel\.app$
# 1 = run `alembic upgrade head` when the container starts (Render free plan has no pre-deploy step).
# RUN_MIGRATIONS=0
# The platform sets PORT; defaults to 8000.
